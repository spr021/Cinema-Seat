PORT=4000
MONGO_DB_URL=mongodb://localhost:27017/cinema-db

JWT_SECRET_KEY=change-me
JWT_SECRET_EXPIER=10d

# Optional: Stripe (test mode). Without these the app uses mock payments.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen`)

# Optional: real SMTP. Without these, Ethereal test accounts are used and
# emails are only previewable via logged URLs. Set EMAILS_DISABLED=true to
# skip email entirely (used by the test suite).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USERNAME=...
# EMAIL_PASSWORD=...
# EMAILS_DISABLED=true
APP_URL=http://localhost:8081  # where the checkout return page links back (add to .env if non-default)
